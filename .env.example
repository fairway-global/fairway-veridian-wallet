# Testing
## Android build app path
APP_PATH=<LOCAL_PATH/app-release-unsigned.apk>

## iOS build app path
APP_PATH=<LOCAL_PATH/App.app>

## Allure Results Directory path
ALLURE_RESULTS_DIR=tests/.reports/allure-results

## Choose the environment in the configs folder
ENVIRONMENT=local

# This is used to tunnel iOS/Android simulators to host machine's localhost, will override config. Leave commented out if not needed
#KERIA_IP=127.0.0.1

DEV_SKIP_ONBOARDING=false

APP_CERT_HASH=SESgZA4IIYBMp2rSEMdwazuTnH9/95QFzJQcViQdslI=
APP_WATCHER_MAIL=yourWatcherMail

## iOS
APP_TEAM_ID=yourTeamID

# Optional: credential issuance server base used for /saveFayda routes.
# Keep this separate from REACT_APP_BACKEND_API (Fayda token/userinfo backend).
# REACT_APP_CREDENTIAL_SERVER_API=http://localhost:3001
