# Testing
## Android build app path
APP_PATH=<LOCAL_PATH/app-release-unsigned.apk>

## iOS build app path
APP_PATH=<LOCAL_PATH/App.app>

## Allure Results Directory path
ALLURE_RESULTS_DIR=tests/.reports/allure-results

## Choose the environment in the configs folder
ENVIRONMENT=local

# This is used to tunnel iOS/Android simulators to host machine's localhost, will override config. Leave commented out if not needed
#KERIA_IP=127.0.0.1

DEV_SKIP_ONBOARDING=false

APP_CERT_HASH=R5PFLXC5ErjSK3EzjHBN3SI5aKkyBD9n3j6I7RG+4NI=
APP_WATCHER_MAIL=abrham@fairway.global

## iOS
APP_TEAM_ID=yourTeamID

# Optional: credential issuance server base used for /saveFayda routes.
# Keep this separate from REACT_APP_BACKEND_API (Fayda token/userinfo backend).
# REACT_APP_CREDENTIAL_SERVER_API=http://localhost:3001

# Optional: choose the external identity verification provider used to finalize
# pending connections. Supported values: fayda, candour
# REACT_APP_VERIFICATION_PROVIDER=fayda

# Optional: Candour credential-server base used for /candour/session and
# /saveCandour routes. Defaults to REACT_APP_CREDENTIAL_SERVER_API when omitted.
# REACT_APP_CANDOUR_ISSUER_API=http://localhost:3001

# Optional: callback URL Candour redirects back to. In browser builds the app
# finalizes directly on /callback, so keep this as a normal web URL without
# bridgeToApp. In native app builds the wallet adds bridgeToApp=1 automatically
# before sending the callback URL to Candour.
# REACT_APP_CANDOUR_WEB_REDIRECT_URI=http://localhost:3000/callback?provider=candour

# Optional: native deep-link URI the Candour bridge page sends users back to.
# REACT_APP_CANDOUR_NATIVE_REDIRECT_URI=org.cardanofoundation.idw://fayda/callback?provider=candour

# Backward compatible override: if set to https://... it is treated as the
# Candour web callback URI; if set to a custom scheme it is treated as the
# native app callback URI.
# REACT_APP_CANDOUR_REDIRECT_URI=org.cardanofoundation.idw://fayda/callback?provider=candour

# Optional: release metadata shown inside the Android build info screen.
# Use "|" to separate changelog bullet points.
# REACT_APP_RELEASE_DESCRIPTION=Signed Android release for Fairwallet.
# REACT_APP_RELEASE_DATE=2026-03-30
# REACT_APP_ANDROID_APK_SIZE=28.4 MB
# REACT_APP_ANDROID_APK_SHA256=abc123...
# REACT_APP_RELEASE_CHANGELOG=Updated Fairwallet branding|Fixed wallet scrolling
