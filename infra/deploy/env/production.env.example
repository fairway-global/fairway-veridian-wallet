# Copy this file to infra/deploy/env/production.env on the VM (never commit secrets).
DEPLOY_ENV=production
PUBLIC_DOMAIN=example.com

# Image repositories (deploy script appends :<release_sha>)
KERIA_IMAGE_REPO=ghcr.io/cardano-foundation/veridian-wallet/idw-keria
WITNESS_IMAGE_REPO=ghcr.io/cardano-foundation/veridian-wallet/idw-witness
CRED_IMAGE_REPO=ghcr.io/cardano-foundation/veridian-wallet/cred-issuance
CRED_UI_IMAGE_REPO=ghcr.io/cardano-foundation/veridian-wallet/cred-issuance-ui

# Runtime behavior
DEPLOYMENT_MODE=cloud
WITNESS_COUNT=6
KERIA_CURLS_PROTO=https
ALLOW_INTRODUCTIONS=true
REMOTE_SIGNING=true
KERI_AGENT_CORS=true
ALLOW_LEGACY_UNAUTH_ROUTES=false
JSON_BODY_LIMIT=10mb

# Endpoints advertised by services
KERIA_CURLS=https://keria-ext.${PUBLIC_DOMAIN}
CRED_OOBI_ENDPOINT=https://cred-issuance.${PUBLIC_DOMAIN}
CRED_PUBLIC_OOBI_ENDPOINT=https://cred-issuance.${PUBLIC_DOMAIN}
CRED_KERIA_ENDPOINT=http://keria:3901
CRED_KERIA_BOOT_ENDPOINT=http://keria:3903
CRED_UI_SERVER_URL=https://cred-issuance.${PUBLIC_DOMAIN}

# Required secrets
KERIA_PASSCODE=REPLACE_ME
DATABASE_URL=postgresql://user:password@db-host:5432/credential_server
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
GATEWAY_JWT_SECRET=REPLACE_ME
BRAN_ENCRYPTION_KEY=REPLACE_ME
